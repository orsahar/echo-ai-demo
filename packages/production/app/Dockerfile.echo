# syntax=docker/dockerfile:1
# Base image and npm registry are both parameterized. Defaults pull directly
# from Echo (used by production-build-and-scan.yml, which has no GCP/GAR
# dependency and must keep working even when the GKE/GAR infra is torn down
# between demo sessions). production-deploy.yml overrides both to route
# through GAR instead -- matching Echo's own recommended pattern ("CI/CD
# pulls from your internal registry, not directly from Echo"), since that
# workflow already depends on the live infra anyway.
ARG BASE_IMAGE=reg.echohq.com/node:23
FROM ${BASE_IMAGE}

WORKDIR /app

ARG NPM_REGISTRY=https://npm.echohq.com/

COPY package*.json ./
RUN echo "registry=${NPM_REGISTRY}" > .npmrc

# NPM_AUTH_TOKEN works against either registry via the same _authToken
# mechanism: an Echo Libraries key against npm.echohq.com (verified in
# packages/libraries), or a gcloud access token against a GAR npm remote
# repo (verified directly: real `npm install axios` through
# us-central1-npm.pkg.dev/.../echo-demo-prod-mirror-npm/ resolved a real
# tarball from that host, not a silent fallback to public npm).
#
# npm install occasionally segfaults transiently under this secret-mounted
# RUN (seen both locally and on GitHub's native amd64 runners) -- retry a
# few times before failing the build.
RUN --mount=type=secret,id=NPM_AUTH_TOKEN \
    NPM_AUTH_KEY="//$(node -e "const u=new URL(process.env.NPM_REGISTRY); process.stdout.write(u.host+u.pathname)")":_authToken && \
    npm config set "$NPM_AUTH_KEY" "$(cat /run/secrets/NPM_AUTH_TOKEN)" --location=project && \
    ( install_status=1; \
      for i in 1 2 3; do \
        npm install --omit=dev && install_status=0 && break; \
        echo "npm install failed (attempt $i), retrying..."; \
        sleep 3; \
      done; \
      exit $install_status ); \
    status=$?; \
    npm config delete "$NPM_AUTH_KEY" --location=project || true; \
    exit $status

COPY db.js server.js ./

EXPOSE 8080
CMD ["node", "server.js"]
